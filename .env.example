# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Required ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
OPENAI_API_KEY=sk-proj-your-openai-key

# --- WhatsApp Business API ---
WA_ACCESS_TOKEN=your-whatsapp-token
WA_PHONE_ID=your-phone-number-id
WA_VERIFY_TOKEN=your-webhook-verify-token
WEBHOOK_SECRET=your-webhook-hmac-secret

# --- Google APIs ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Also place your Google service account JSON file in project root

# --- Security ---
CHAT_TOKEN_SECRET=any-random-64-char-hex-string
ADMIN_API_KEY=any-random-64-char-hex-string

# --- Email (Gmail SMTP) ---
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Optional ---
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CHAT_AUTH_STRICT=true
PORT=3000
